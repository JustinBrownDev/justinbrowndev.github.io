{
  "schema": "jweb.authored-location.v1",
  "id": "spawn.rooftop-reality-leak",
  "workingNames": [
    "Rooftop Reality Leak",
    "Vacuum Tube Terrace",
    "Late Shift Roof"
  ],
  "kind": "singular-authored-procedural-location",
  "role": "player-spawn-and-first-real-authored-place",
  "thesis": "A cheap, improvised rooftop refuge at night where somebody has been watching live television above the generated city. It feels lonely, comforting, inhabited, technically plausible, and a little impossible because a giant glowing vacuum-tube monument occupies the nearby skyline.",
  "emotionalFingerprint": {
    "mustAlwaysFeelLike": [
      "a private refuge discovered rather than presented",
      "late-night current reality leaking into a procedural world",
      "someone was here very recently",
      "cheap objects made comfortable through arrangement",
      "electronics as ordinary life and minor mythology",
      "a safe pause before descending into the cramped city"
    ],
    "mustNeverFeelLike": [
      "tutorial room",
      "developer test scene",
      "luxury rooftop bar",
      "post-apocalypse survivor camp",
      "quest hub",
      "cyberpunk showroom",
      "random junk dump"
    ]
  },
  "hardInvariants": [
    {
      "beat": "safe-arrival",
      "rule": "Spawn stands on structurally safe roof fabric with a clear capsule and an immediately legible path away."
    },
    {
      "beat": "social-media-focus",
      "rule": "One real-broadcast-capable television or monitor is the social focus, supported plausibly and visible from multiple seats."
    },
    {
      "beat": "human-refuge",
      "rule": "At least two believable seating opportunities and one small shared surface create a place to stay, not merely pass through."
    },
    {
      "beat": "recent-presence",
      "rule": "At least three life props imply very recent occupancy: drink, ash/snack, paper, clothing, tool, keys, or similar."
    },
    {
      "beat": "warm-cool-split",
      "rule": "Cool moving screen light and at least one warmer practical light overlap without flattening the roof into uniform illumination."
    },
    {
      "beat": "skyline-electronics-icon",
      "rule": "A fictionalized giant vacuum-tube structure on a nearby building is visible from the refuge and acts as the first navigational memory."
    },
    {
      "beat": "real-roof-context",
      "rule": "Mechanical or communications hardware makes the location unambiguously a working rooftop."
    },
    {
      "beat": "city-exit",
      "rule": "A connector toward stairs, fire escape, hatch, door, bridge, or equivalent city circulation remains visually and physically unobstructed."
    }
  ],
  "zones": [
    {
      "id": "arrival",
      "role": "spawn threshold",
      "rules": [
        "clear capsule",
        "first glance sees either TV glow or vacuum-tube silhouette",
        "never spawn inside furniture"
      ]
    },
    {
      "id": "refuge",
      "role": "social cluster",
      "rules": [
        "TV + support + seats + shared surface",
        "slightly asymmetric",
        "tight enough to feel intentional"
      ]
    },
    {
      "id": "edge-lookout",
      "role": "skyline reading zone",
      "rules": [
        "parapet or protected edge",
        "vacuum landmark sightline",
        "optional single seat or binoculars"
      ]
    },
    {
      "id": "utility",
      "role": "roof credibility",
      "rules": [
        "HVAC/vents/conduit/antenna cluster",
        "frames refuge",
        "does not block connector"
      ]
    },
    {
      "id": "descent",
      "role": "connection to generated city",
      "rules": [
        "connector authority owns aperture/circulation",
        "authored props respect keep-clear reservation"
      ]
    }
  ],
