  "variationPolicy": {
    "seeded": true,
    "preserveHardInvariants": true,
    "antiRepeat": [
      "do not reuse exact TV+support+primary-seat tuple on consecutive world seeds when alternatives exist",
      "expand family variety before exact asset repeat",
      "vary microstory independently from roof utility mix",
      "allow furniture orientation jitter only inside semantic relationships"
    ],
    "matchingFurniturePenalty": 0.75,
    "symmetryPenalty": 0.85,
    "luxuryPenalty": 1.0
  },
  "progressiveRealization": [
    {
      "phase": 0,
      "id": "structural-safe",
      "mustExistBeforePlay": true,
      "contents": [
        "roof fabric",
        "parapets/edge safety",
        "spawn capsule",
        "descent connector",
        "collision and keep-clear reservations"
      ]
    },
    {
      "phase": 1,
      "id": "memory-silhouette",
      "mustExistBeforeFirstStableLook": true,
      "contents": [
        "TV/support mass",
        "minimum two seats",
        "one practical light proxy",
        "vacuum-tube skyline silhouette",
        "one roof utility silhouette"
      ]
    },
    {
      "phase": 2,
      "id": "identity",
      "contents": [
        "selected authored asset variants",
        "shared surface",
        "primary cable logic",
        "recent-presence props"
      ]
    },
    {
      "phase": 3,
      "id": "life",
      "contents": [
        "soft goods",
        "additional clutter",
        "secondary utilities",
        "plants",
        "wear and small residue"
      ]
    },
    {
      "phase": 4,
      "id": "live-reality",
      "contents": [
        "official live media embed if available",
        "muted autoplay",
        "distance-aware activation",
        "nonfatal fallback screen"
      ]
    },
    {
      "phase": 5,
      "id": "fine-detail",
      "contents": [
        "micro cables",
        "labels/text from semantic content",
        "small repair parts",
        "minor light spill refinements"
      ]
    }
  ],
  "mediaIntent": {
    "sourceKey": "live-news.al-jazeera-english",
    "importance": "identity-but-nonauthoritative-runtime",
    "defaultAudio": "muted",
    "fallback": "dark glass / subtle static / NO SIGNAL",
    "networkFailureIsFatal": false
  },
  "semanticRequirements": [
    "fabric-published rooftop space",
    "connector-owned descent aperture",
    "circulation reservations authoritative",
    "stable location/space/entity ids",
    "external media lifecycle separate from world identity"
  ],
  "successTest": "Across seeds, screenshots should not match object-for-object, but a player should identify the place as the same rooftop memory without being told its name."
}
