+// ---------- semantic room placement ----------
+// The city-pack catalog already says what an object IS and where it mounts.
+// Keep that meaning all the way through placement: floor furniture chooses a
+// real wall slot, wall props back onto that wall, desk/table props sit on a
+// recorded work surface, and ceiling props solve their Y from the ceiling.
+// Wall intervals are reserved per floor so "correct wall" does not become
+// "five shelves occupying the same correct wall".
+const semanticRoomPlacement = new WeakMap();
+function semanticFloorState(rect, yLevel) {
+    let floors = semanticRoomPlacement.get(rect);
+    if (!floors) semanticRoomPlacement.set(rect, floors = new Map());
+    const key = Math.round(yLevel * 1000);
+    let state = floors.get(key);
+    if (!state) floors.set(key, state = { wallUsage: new Map(), supports: [], supportCursor: 0, cornerCursor: Math.floor(rng() * 4) });
+    return state;
+}
+function semanticAssetBounds(def) {
+    const min = def?.boundsMin ?? [-0.3, 0, -0.3];
+    const max = def?.boundsMax ?? [0.3, 0.8, 0.3];
+    const dims = def?.dimensionsXYZ ?? [max[0] - min[0], max[1] - min[1], max[2] - min[2]];
+    return { min, max, dims };
+}
+function semanticUsableSides(rect) {
+    return CELL_SIDE_DEFS.filter(side => {
+        const kind = rect.edgeKinds?.[side.key];
+        return kind !== 'internal' && kind !== 'courtyard';
+    });
+}
+function semanticWallPose(rect, def, yLevel = 0, opts = {}) {
+    const state = semanticFloorState(rect, yLevel);
+    const { min, dims } = semanticAssetBounds(def);
+    const width = Math.max(0.18, dims[0] * (opts.scaleX ?? 1));
+    const depth = Math.max(0.06, dims[2] * (opts.scaleZ ?? 1));
+    const sides = semanticUsableSides(rect);
+    if (!sides.length) return null;
+    const start = Math.floor(rng() * sides.length);
+
+    for (let si = 0; si < sides.length; si++) {
+        const side = sides[(start + si) % sides.length];
+        const tangentHalf = side.dz !== 0 ? rect.hwx : rect.hwz;
+        const avail = tangentHalf - width / 2 - 0.18;
+        if (avail < 0.02) continue;
+        let used = state.wallUsage.get(side.key);
+        if (!used) state.wallUsage.set(side.key, used = []);
+        const candidates = [0, -avail * 0.58, avail * 0.58, -avail, avail];
+        for (const u of candidates) {
+            // Keep the ground-floor entry fan clear.  Upper-floor fire-escape
+            // openings are centered too, so keeping the central slot clear on
+            // that face also avoids putting a shelf across an exterior exit.
+            const isDoorSide = rect.doorSide && rect.doorSide.dx === side.dx && rect.doorSide.dz === side.dz;
+            const isFireSide = rect.fireEscapeSide && rect.fireEscapeSide.dx === side.dx && rect.fireEscapeSide.dz === side.dz;
+            if ((isDoorSide && yLevel < 0.1 || isFireSide && yLevel > 0.1) && Math.abs(u) < 1.0 + width / 2) continue;
+            const lo = u - width / 2, hi = u + width / 2;
+            if (used.some(r => lo - 0.12 < r.hi && r.lo < hi + 0.12)) continue;
+            used.push({ lo, hi });
+            const tx = side.dz !== 0 ? 1 : 0, tz = side.dx !== 0 ? 1 : 0;
+            const wallX = rect.cx + side.dx * (rect.hwx - 0.03);
+            const wallZ = rect.cz + side.dz * (rect.hwz - 0.03);
+            // local +Z faces INTO the room.  Use the actual asymmetric local
+            // bounds: the back-most vertex (minZ) clears the wall by 4cm.
+            const inwardOffset = Math.max(depth * 0.5, -min[2]) + 0.04;
+            return {
+                x: wallX + tx * u - side.dx * inwardOffset,
+                z: wallZ + tz * u - side.dz * inwardOffset,
+                rotY: outwardRotationY(-side.dx, -side.dz),
